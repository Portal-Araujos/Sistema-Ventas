generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- GEOGRAFÍA ---
model Provincia {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  cantones  Canton[]

  @@map("provincias")
}

model Canton {
  id           Int         @id @default(autoincrement())
  provinciaId  Int         @map("provincia_id")
  nombre       String
  provincia    Provincia   @relation(fields: [provinciaId], references: [id], onDelete: Cascade)
  parroquias   Parroquia[]

  @@map("cantones")
}

model Parroquia {
  id           Int           @id @default(autoincrement())
  cantonId     Int           @map("canton_id")
  nombre       String
  canton       Canton        @relation(fields: [cantonId], references: [id], onDelete: Cascade)
  instituciones Institution[]

  @@map("parroquias")
}

// --- CATÁLOGOS DINÁMICOS ---
model Sostenimiento {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  instituciones Institution[]

  @@map("sostenimientos")
}

model Jornada {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  instituciones Institution[]

  @@map("jornadas")
}

model NivelEducativo {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  instituciones Institution[]

  @@map("niveles_educativos")
}

model AreaEducativa {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  instituciones Institution[]

  @@map("areas_educativas")
}

model RegimenEscolar {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  instituciones Institution[]

  @@map("regimenes_escolares")
}

model Jurisdiccion {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  instituciones Institution[]

  @@map("jurisdicciones")
}

model ModalidadEducativa {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  instituciones Institution[]

  @@map("modalidades_educativas")
}

model AccesoEdificio {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  instituciones Institution[]

  @@map("accesos_edificio")
}

model ReglaTamano {
  id           Int      @id @default(autoincrement())
  nombre       String   @unique
  minDocentes  Int      @default(0) @map("min_docentes")
  maxDocentes  Int      @default(9999) @map("max_docentes")

  @@map("reglas_tamano")
}

// --- SEGURIDAD ---
model Rol {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  usuarios  Usuario[]

  @@map("roles")
}

model Permiso {
  id        Int              @id @default(autoincrement())
  nombre    String           @unique
  modulo    String
  usuarios  PermisoUsuario[]

  @@map("permisos")
}
model EstadoComercial {
  id            Int           @id @default(autoincrement())
  nombre        String        @unique
  activo        Boolean       @default(true)
  
  // Le ponemos el nombre explícito a la relación aquí:
  instituciones Institution[] @relation("EstadoToInst")

  @@map("estados_comerciales")
}
model PermisoUsuario {
  usuarioId String   @map("usuario_id")
  permisoId Int      @map("permiso_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permiso   Permiso  @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, permisoId])
  @@map("permisos_usuarios")
}

model Usuario {
  id           String           @id @default(uuid())
  rolId        Int              @map("rol_id")
  nombre       String
  email        String           @unique
  passwordHash String           @map("password_hash")
  activo       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  rol          Rol              @relation(fields: [rolId], references: [id])
  permisos     PermisoUsuario[]
  institucionesCreadas  Institution[]    @relation("CreadoPor")
  institucionesAsignadas Institution[]   @relation("VendedorResponsable")
  visitas      VisitaAgenda[]

  @@map("usuarios")
}

// --- TABLA PRINCIPAL DE INSTITUCIONES ---
model Institution {
  id                   String              @id @default(uuid())
  nombre               String
  
  // Catálogos
  sostenimientoId      Int                 @map("sostenimiento_id")
  sostenimiento        Sostenimiento       @relation(fields: [sostenimientoId], references: [id])
  
  jornadaId            Int                 @map("jornada_id")
  jornada              Jornada             @relation(fields: [jornadaId], references: [id])

  parroquiaId          Int                 @map("parroquia_id")
  parroquia            Parroquia           @relation(fields: [parroquiaId], references: [id])

  docentesHombres      Int                 @default(0) @map("docentes_hombres")
  docentesMujeres      Int                 @default(0) @map("docentes_mujeres")
  totalDocentes        Int                 @default(0) @map("total_docentes")

  tamano               String              @default("Pequeña")
  estadoComercialId    Int?                @map("estado_comercial_id")
  estadoComercialRel   EstadoComercial?    @relation("EstadoToInst", fields: [estadoComercialId], references: [id])
  estadoComercial      String              @default("No visitada") @map("estado_comercial")

  nivelEducativoId     Int?                @map("nivel_educativo_id")
  nivelEducativo       NivelEducativo?     @relation(fields: [nivelEducativoId], references: [id])

  areaId               Int?                @map("area_id")
  area                 AreaEducativa?      @relation(fields: [areaId], references: [id])

  regimenId            Int?                @map("regimen_id")
  regimen              RegimenEscolar?     @relation(fields: [regimenId], references: [id])

  jurisdiccionId       Int?                @map("jurisdiccion_id")
  jurisdiccion         Jurisdiccion?       @relation(fields: [jurisdiccionId], references: [id])

  modalidadId          Int?                @map("modalidad_id")
  modalidad            ModalidadEducativa? @relation(fields: [modalidadId], references: [id])

  accesoEdificioId     Int?                @map("acceso_edificio_id")
  accesoEdificio       AccesoEdificio?     @relation(fields: [accesoEdificioId], references: [id])

  // AUDITORÍA Y VENDEDOR RESPONSABLE
  creadoPor            String              @map("creado_por")
  usuarioCreador       Usuario             @relation("CreadoPor", fields: [creadoPor], references: [id])

  vendedorId           String?             @map("vendedor_id")
  vendedor             Usuario?            @relation("VendedorResponsable", fields: [vendedorId], references: [id], onDelete: SetNull)

  createdAt            DateTime            @default(now()) @map("created_at")
  visitas              VisitaAgenda[]

  @@map("instituciones")
}

model VisitaAgenda {
  id                   String      @id @default(uuid())
  institucionId        String      @map("institucion_id")
  usuarioId            String      @map("usuario_id")
  fechaProgramada      DateTime    @map("fecha_programada") @db.Date
  horaProgramada       String      @map("hora_programada")
  tipoGestion          String      @map("tipo_gestion")
  estadoGestion        String      @default("Pendiente") @map("estado_gestion")
  resumenAcuerdos      String?     @map("resumen_acuerdos") @db.Text
  fechaProximoContacto DateTime?   @map("fecha_proximo_contacto") @db.Date
  latitud              Float?
  longitud             Float?
  createdAt            DateTime    @default(now()) @map("created_at")
  institucion          Institution @relation(fields: [institucionId], references: [id], onDelete: Cascade)
  usuario              Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("visitas_agenda")
}